libboldmerge = library(
  'boldmerge-1',
  boldmerge_sources,
  boldmerge_resources,
  version: meson.project_version(),
  soversion: '0',
  include_directories: include_directories('../include'),
  dependencies: [gtk_dep, adw_dep, math_dep],
  install: true,
)

boldmerge_dep = declare_dependency(
  link_with: libboldmerge,
  include_directories: include_directories('../include'),
  dependencies: [gtk_dep, adw_dep],
)
