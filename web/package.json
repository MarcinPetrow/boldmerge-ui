  "scripts": {
    "clean": "node scripts/clean.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && npm run tokens:sync && tsc -p tsconfig.build.json && rollup -c && node scripts/copy-assets.mjs",
    "api:check": "node scripts/check-public-api.mjs",
    "api:update": "node scripts/check-public-api.mjs --update",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:firefox": "playwright test --config=playwright.cross-browser.config.ts --project=firefox",
    "test:webkit": "playwright test --config=playwright.cross-browser.config.ts --project=webkit",
    "test:browser-matrix": "playwright test --config=playwright.cross-browser.config.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run tokens:check && npm run typecheck && npm run build && npm run api:check && npm test"
  },
  "dependencies": {
    "lit": "3.3.3",
    "lucide": "1.73.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "rollup": "4.68.2",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
